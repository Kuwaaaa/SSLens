{
  "name": "lumen",
  "private": true,
  "version": "0.2.0",
  "bin": {
    "lumen-roadmap-mcp": "scripts/roadmap-mcp-bin.js"
  },
  "description": "Lumen v2 — social Lens layer for the web",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun --hot apps/server/src/index.ts",
    "start:server": "bun apps/server/src/index.ts",
    "dev:roadmap": "bun scripts/serve-roadmap.ts",
    "mcp:roadmap": "bun scripts/roadmap-mcp.ts",
    "dev:extension": "cd apps/extension && bun run dev",
    "build:extension": "cd apps/extension && bun run build",
    "build:extension:http-beta": "cd apps/extension && bun run build:http-beta",
    "keygen": "bun scripts/keygen.ts",
    "issue-invite": "bun scripts/issue-invite.ts",
    "deploy:vps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-lumen-vps.ps1",
    "check:vps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-lumen-vps.ps1",
    "typecheck": "bun x tsc -p packages/schema/tsconfig.json --noEmit && bun x tsc -p packages/url/tsconfig.json --noEmit && bun x tsc -p packages/anchoring/tsconfig.json --noEmit && bun x tsc -p apps/extension/tsconfig.json --noEmit && bun x tsc -p apps/server/tsconfig.json --noEmit",
    "test:canonicalize": "bun scripts/canonicalize-url.test.ts",
    "test:anchoring": "bun packages/anchoring/src/anchoring.test.ts",
    "test:schema": "bun packages/schema/src/validation.test.ts",
    "test:extension": "bun test ./apps/extension/src/**/*.test.ts",
    "test": "bun run test:canonicalize && bun run test:anchoring && bun run test:schema && bun run test:extension"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "^5.4.0"
  }
}
